FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /bin/tenantzero-server ./server

FROM alpine:3.19
COPY --from=build /bin/tenantzero-server /usr/local/bin/
COPY --from=build /src/server/store/migrations /migrations
ENTRYPOINT ["tenantzero-server", "-migrations", "/migrations"]